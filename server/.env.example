# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"
MONGODB_DB="koya_booking"

# The key clients must send in the X-API-Key header
API_KEY="change-me"

PORT=4000

# Optional
# TRUST_PROXY_HOPS=1     # reverse proxies in front of the app (Render: 1)
# LOG_LEVEL=info         # fatal | error | warn | info | debug | trace | silent
